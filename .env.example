# Local development template. Copy to .env.local and fill in.
#
# `.env` and `.env.*` are gitignored except this file. In deployed environments
# these values come from SOPS-encrypted files decrypted at deploy time
# (ADR 0049); there is no plaintext .env on the VPS.
#
# Generate the three keys with:
#   openssl rand -base64 32

NODE_ENV=development

API_PORT=3000
API_PUBLIC_URL=http://localhost:3000

# Three roles, three URLs (ADR 0043). One shared superuser URL would make the
# whole row-level-security model decorative.
DATABASE_URL_APP=postgres://app_user:app_user_dev@localhost:5432/platform
DATABASE_URL_WORKER=postgres://app_worker:app_worker_dev@localhost:5432/platform
DATABASE_URL_MIGRATOR=postgres://migrator:migrator_dev@localhost:5432/platform

# Superuser, used ONLY by `pnpm db:bootstrap` to create the three roles.
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/platform
APP_USER_PASSWORD=app_user_dev
APP_WORKER_PASSWORD=app_worker_dev
MIGRATOR_PASSWORD=migrator_dev

REDIS_URL=redis://localhost:6379

# ADR 0046. NEVER rotated: rotation would require recomputing digests from
# addresses the platform has deliberately not kept. Losing it silently destroys
# every suppression record and the platform resumes sending to people who
# unsubscribed, with no error.
SUPPRESSION_PEPPER=

# ADR 0033. AES-256-GCM for provider OAuth tokens at rest. Rotatable.
TOKEN_ENCRYPTION_KEY=

# Slice 5. Signs RSVP and unsubscribe tokens. Rotatable; the rotation policy
# is OPEN-S5 and undecided.
SIGNING_KEY_ID=dev-1
SIGNING_KEY_SECRET=

# ADR 0035. Optional locally.
SENTRY_DSN=
LOG_LEVEL=debug

# Test database. The RLS and withOrg suites skip without these and say so.
TEST_DATABASE_URL_MIGRATOR=postgres://migrator:migrator_dev@localhost:5432/platform_test
TEST_DATABASE_URL_APP=postgres://app_user:app_user_dev@localhost:5432/platform_test
